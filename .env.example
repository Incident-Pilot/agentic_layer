# Copy this file to .env and fill in the key(s) for whichever provider(s)
# you use. .env is loaded automatically (see incident_pilot_agent/config.py)
# and is gitignored -- never commit real keys.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_MODEL=nthropic/claude-sonnet-5

# Per-graph-node model overrides (only take effect with --llm openrouter --
# see incident_pilot_agent/cli.py._node_model). Each falls back to
# OPENROUTER_MODEL above when unset, so leaving all of these blank is
# identical to today's single-model behavior.
#
# Why split at all: the Investigator's job each round is picking which of a
# few known tools to call next -- low-stakes, repetitive, tool-orchestration
# work a cheaper/faster model handles fine. The Synthesizer (propose a root
# cause) and Verifier (confirm/reject it) are the highest-stakes reasoning
# steps in the graph -- a cheap model here has actually produced weaker,
# less-supported hypotheses in real runs. So: cheap for investigation,
# strong for judgment calls.
# INVESTIGATOR_MODEL=openai/gpt-4o-mini
# SYNTHESIZER_MODEL=anthropic/claude-sonnet-5
# VERIFIER_MODEL=anthropic/claude-sonnet-5
# REMEDIATION_MODEL is for the remediation planner node (see
# agents/remediation_planner.py) -- also a judgment call, so lean strong.
# REMEDIATION_MODEL=anthropic/claude-sonnet-5

# Bedrock, reached via the Mantle gateway -- OpenAI-compatible, same as
# OpenRouter above, just a different base_url/key/model (see config.py).
# Generate the bearer token from the AWS console; watch for stray
# leading/trailing whitespace when pasting it in, config.py strips it but
# double-check if auth ever fails unexpectedly.
AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_MODEL=moonshotai.kimi-k2.5

# Per-graph-node Bedrock model overrides -- same reasoning and same
# cli.py._node_model gate as INVESTIGATOR_MODEL/etc. above, just scoped to
# --llm bedrock. Each falls back to BEDROCK_MODEL above when unset. Model
# ids confirmed available through this gateway at the time of writing
# (GET /v1/models) -- worth re-checking if these ever 404.
# BEDROCK_INVESTIGATOR_MODEL=anthropic.claude-haiku-4-5
# BEDROCK_SYNTHESIZER_MODEL=anthropic.claude-sonnet-5
# BEDROCK_VERIFIER_MODEL=anthropic.claude-sonnet-5
# BEDROCK_REMEDIATION_MODEL=anthropic.claude-sonnet-5

# Read-only investigation API (incident_pilot_agent/api/), served alongside
# `watch`. Generate with: openssl rand -hex 32
AGENT_API_KEY=
# AGENT_API_HOST=0.0.0.0
# AGENT_API_PORT=8100
