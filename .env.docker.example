# Copy this file to .env.docker and fill in real values. Passed to the
# container via `docker compose --env-file .env.docker` or `docker run
# --env-file .env.docker ...` -- never baked into the image itself.
# .env.docker is gitignored -- never commit real keys.

# --- LLM provider ---------------------------------------------------------
# Set whichever provider(s) you use; --llm/_default_llm_name() (cli.py) picks
# one automatically if you don't pass --llm explicitly.
#
# OPENROUTER_API_KEY + OPENROUTER_MODEL is the recommended default here --
# it's the path actually proven working end-to-end on this project (OpenAI
# hit a hard quota wall, Gemini's free tier is too limited for this
# workload's call volume). OPENROUTER_MODEL's default (openai/gpt-4o-mini,
# see config.py) is a live, ongoing decision -- override below if you're
# using something else, don't assume the default is final.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Gateway -----------------------------------------------------------
# The Gateway is ClusterIP-only (not exposed externally) and this container
# does not run inside the k3s cluster, so it needs the same
# `kubectl port-forward svc/observation-gateway 8000:8000` bridge a human
# uses manually today, running on the host machine before you start this
# container. Which URL reaches that bridge from inside a container depends
# on your OS/Docker setup:
#
#   - Linux with `docker run --network host` (or docker-compose.yml's
#     `network_mode: host`): http://localhost:8000
#   - macOS/Windows Docker Desktop (--network host isn't supported the same
#     way there): http://host.docker.internal:8000
#
# Pick the one that matches how you're running the container.
INCIDENT_GATEWAY_URL=http://host.docker.internal:8000
INCIDENT_GATEWAY_API_KEY=

# --- watch polling ---------------------------------------------------------
# Has a sane default (30s, matches Alertmanager's group_interval elsewhere in
# this project) -- only set this to override it.
# INCIDENT_PILOT_WATCH_POLL_INTERVAL_SECONDS=30

# --- Read-only investigation API (incident_pilot_agent/api/) ---------------
# Served alongside `watch` in the same process/container. Required, not
# conditional -- these are always read at container startup.
# Generate AGENT_API_KEY with: openssl rand -hex 32
AGENT_API_KEY=
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8100
