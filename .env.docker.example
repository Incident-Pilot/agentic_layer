# Copy this file to .env.docker and fill in real values. Passed to the
# container via `docker compose --env-file .env.docker` or `docker run
# --env-file .env.docker ...` -- never baked into the image itself.
# .env.docker is gitignored -- never commit real keys.

# --- LLM provider ---------------------------------------------------------
# Set whichever provider(s) you use; --llm/_default_llm_name() (cli.py) picks
# one automatically if you don't pass --llm explicitly.
#
# OpenRouter and Bedrock are the two actively-used providers on this
# project (OpenAI hit a hard quota wall, Gemini's free tier is too limited
# for this workload's call volume, so those two plus Anthropic direct are
# left in place but unmaintained going forward, not removed). Pick one:
#
# OPENROUTER_API_KEY + OPENROUTER_MODEL is the path proven working
# end-to-end first. OPENROUTER_MODEL's default (openai/gpt-4o-mini, see
# config.py) is a live, ongoing decision -- override below if you're using
# something else, don't assume the default is final.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Per-graph-node overrides, only meaningful on this OpenRouter path (see
# .env.example for the full reasoning): cheap/fast for the Investigator's
# repetitive tool-orchestration, strong for the Synthesizer/Verifier's
# actual judgment calls -- a cheap model has produced weaker, less-supported
# hypotheses in real runs. Each falls back to OPENROUTER_MODEL when unset.
# INVESTIGATOR_MODEL=openai/gpt-4o-mini
# SYNTHESIZER_MODEL=anthropic/claude-sonnet-5
# VERIFIER_MODEL=anthropic/claude-sonnet-5
# REMEDIATION_MODEL=anthropic/claude-sonnet-5

# Bedrock, reached via the Mantle gateway -- the other actively-used
# provider alongside OpenRouter above. OpenAI-compatible, same pattern:
# custom base_url/key/model, no separate client. Per-graph-node overrides
# follow the same cheap-investigator/strong-judgment split, only meaningful
# with --llm bedrock, each falling back to BEDROCK_MODEL when unset.
AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_MODEL=moonshotai.kimi-k2.5
# BEDROCK_INVESTIGATOR_MODEL=anthropic.claude-haiku-4-5
# BEDROCK_SYNTHESIZER_MODEL=anthropic.claude-sonnet-5
# BEDROCK_VERIFIER_MODEL=anthropic.claude-sonnet-5
# BEDROCK_REMEDIATION_MODEL=anthropic.claude-sonnet-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Gateway -----------------------------------------------------------
# The Gateway is ClusterIP-only (not exposed externally) and this container
# does not run inside the k3s cluster, so it needs the same
# `kubectl port-forward svc/observation-gateway 8000:8000` bridge a human
# uses manually today, running on the host machine before you start this
# container. Which URL reaches that bridge from inside a container depends
# on your OS/Docker setup:
#
#   - Linux with `docker run --network host` (or docker-compose.yml's
#     `network_mode: host`): http://localhost:8000
#   - macOS/Windows Docker Desktop (--network host isn't supported the same
#     way there): http://host.docker.internal:8000
#
# Pick the one that matches how you're running the container.
INCIDENT_GATEWAY_URL=http://host.docker.internal:8000
INCIDENT_GATEWAY_API_KEY=

# --- watch polling ---------------------------------------------------------
# Has a sane default (30s, matches Alertmanager's group_interval elsewhere in
# this project) -- only set this to override it.
# INCIDENT_PILOT_WATCH_POLL_INTERVAL_SECONDS=30

# --- Read-only investigation API (incident_pilot_agent/api/) ---------------
# Served alongside `watch` in the same process/container. Required, not
# conditional -- these are always read at container startup.
# Generate AGENT_API_KEY with: openssl rand -hex 32
AGENT_API_KEY=
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8100
